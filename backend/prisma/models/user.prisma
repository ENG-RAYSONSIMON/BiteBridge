model User {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  password  String
  phone     String?
  role      UserRole @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant  Restaurant?
  orders      Order[]
  riderOrders Order[]     @relation("RiderOrders")
}
