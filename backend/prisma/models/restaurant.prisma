model Restaurant {
  id          String   @id @default(uuid())
  ownerId     String   @unique
  name        String
  description String?
  address     String
  phone       String?
  isOpen      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner     User       @relation(fields: [ownerId], references: [id])
  menuItems MenuItem[]
  orders    Order[]
}
