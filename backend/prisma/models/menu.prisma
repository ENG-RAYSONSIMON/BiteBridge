model MenuItem {
  id          String  @id @default(uuid())
  name        String
  description String?
  price       Float
  isAvailable Boolean @default(true)
  imageUrl    String?

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]
}
